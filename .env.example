# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1

# URL pública de la app (sin trailing slash)
APP_URL=http://your-env.us-east-1.elasticbeanstalk.com

# Secret para firmar cookies (usa un string largo y aleatorio)
COOKIE_SECRET=cambia-esto-por-un-string-largo-y-aleatorio
